# Copy this file to .env. Never commit the real API key.
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL. DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# FORMPILOT_MODEL=deepseek-v4-flash
# FORMPILOT_API_MODE=auto
OPENAI_BASE_URL=

# Balanced default for autonomous form-tool decisions.
FORMPILOT_MODEL=gpt-5.6-terra
# auto | responses | chat  (DeepSeek models/base URLs select chat automatically)
FORMPILOT_API_MODE=auto
FORMPILOT_REASONING_EFFORT=medium
FORMPILOT_MAX_STEPS=30
FORMPILOT_HEADLESS=0
FORMPILOT_TRACE=1

# Local browser state. Relative paths are resolved from the working directory.
FORMPILOT_BROWSER_PROFILE=.formpilot/browser-profile

# Optional: connect to a Chromium instance started with remote debugging.
FORMPILOT_CDP_URL=
