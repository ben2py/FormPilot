# Copy this file to .env. Never commit the real API key.
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL. DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# FORMPILOT_MODEL=deepseek-v4-flash
# FORMPILOT_API_MODE=auto
OPENAI_BASE_URL=

# Balanced default for autonomous form-tool decisions.
FORMPILOT_MODEL=gpt-5.6-terra
# auto | responses | chat  (DeepSeek models/base URLs select chat automatically)
FORMPILOT_API_MODE=auto
FORMPILOT_REASONING_EFFORT=medium
FORMPILOT_MAX_STEPS=100
FORMPILOT_HEADLESS=0
FORMPILOT_TRACE=1
# Speed: shorten browser waits (~0.35x). Biggest win is still fewer model rounds + low reasoning.
# FORMPILOT_FAST=1
# FORMPILOT_WAIT_SCALE=0.35
# FORMPILOT_REASONING_EFFORT=low
# FORMPILOT_AUTO_APPROVE=1

# Captcha: auto = local ddddocr then LLM vision; llm = vision only
# FORMPILOT_CAPTCHA_BACKEND=auto
# Auto-login captcha retries before asking human (default 5):
# FORMPILOT_CAPTCHA_RETRIES=5
# Dedicated vision backend (independent from FORMPILOT_MODEL / DeepSeek):
# FORMPILOT_VISION_MODEL=qwen3-vl-plus
# FORMPILOT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FORMPILOT_VISION_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...   # optional fallback for FORMPILOT_VISION_API_KEY

# Local browser state. Relative paths are resolved from the working directory.
FORMPILOT_BROWSER_PROFILE=.formpilot/browser-profile

# Web console (formpilot-web)
# FORMPILOT_WEB_HOST=127.0.0.1
# FORMPILOT_WEB_PORT=8787

# Optional: connect to a Chromium instance started with remote debugging.
# Optional temporary auto-login (local only; never commit real values)
# FORMPILOT_LOGIN_USERNAME=
# FORMPILOT_LOGIN_PASSWORD=
# FORMPILOT_CREDENTIALS_FILE=credentials.json
FORMPILOT_CDP_URL=

FORMPILOT_VISION_MODEL=qwen3-vl-plus
FORMPILOT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FORMPILOT_VISION_API_KEY=你的百炼key