{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "0.1.0",
  "description": "理解当前网页并在确认后填写表单，不自动提交。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "FormPilot",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core/formpilot-core.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
